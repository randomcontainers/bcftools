# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=alpine:3.24

FROM ${BASE_IMAGE} AS build
SHELL ["/bin/ash", "-euo", "pipefail", "-c"]
# perl and bash run the test suite.
RUN apk add --no-cache \
      bash \
      build-base \
      bzip2-dev \
      curl \
      curl-dev \
      libdeflate-dev \
      openssl-dev \
      perl \
      pkgconf \
      scanelf \
      xz-dev \
      zlib-dev

ARG VERSION
ARG SOURCE_SHA256
RUN printf '%s\n' "${VERSION}" | grep -Eqx '1\.[0-9]+(\.[0-9]+)?' \
      || { echo "unexpected VERSION: ${VERSION}" >&2; exit 1; }; \
    printf '%s\n' "${SOURCE_SHA256}" | grep -Eqx '[0-9a-f]{64}' \
      || { echo "SOURCE_SHA256 must be the tarball's sha256" >&2; exit 1; }; \
    url="https://github.com/samtools/bcftools/releases/download/${VERSION}/bcftools-${VERSION}.tar.bz2"; \
    curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 -o /tmp/bcftools.tar.bz2 "$url"; \
    echo "${SOURCE_SHA256}  /tmp/bcftools.tar.bz2" | sha256sum -c -; \
    mkdir /src; \
    tar -xjf /tmp/bcftools.tar.bz2 -C /src --strip-components=1; \
    rm /tmp/bcftools.tar.bz2; \
    echo "$url" > /tmp/source-url

# configure also configures the bundled HTSlib, which is linked in
# statically. Remote files (http, https, S3, Google Cloud Storage) and
# libdeflate are requested explicitly, so configure fails instead of
# leaving them out. GSL and perl filters stay off: either one makes the
# binary GPL. The plugins are built into libexec/bcftools, the directory
# compiled in as their default search path. make check runs the test suite
# with the plugins and the bundled bgzip and tabix.
ARG JOBS
WORKDIR /src
RUN ./configure \
      --prefix=/usr/local \
      --disable-libgsl \
      --disable-perl-filters \
      --enable-libcurl \
      --enable-gcs \
      --enable-s3 \
      --with-libdeflate; \
    make -j"${JOBS:-$(nproc)}"; \
    make check

ARG BASE_IMAGE
# The misc/ scripts need perl or python3, which the image does not have,
# so only bcftools, its plugins, bgzip and tabix are installed. NOTICES
# takes from each C file its first comment (a /* */ block or a run of //
# lines) with a copyright line, if a copyright line in it, or a line right
# below one that starts with a year, names a holder other than Genome
# Research. runtime-deps lists the so: names these need, plus the
# packages in runtime-deps.alpine.
RUN --mount=type=bind,source=runtime-deps.alpine,target=/tmp/runtime-deps.extra \
    set -- htslib-*/; \
    if [ "$#" -ne 1 ] || [ ! -d "$1" ]; then echo "expected one bundled htslib directory: $*" >&2; exit 1; fi; \
    hts=${1%/}; \
    found=; \
    missing=; \
    for d in HAVE_LIBCURL ENABLE_GCS ENABLE_S3 HAVE_HMAC HAVE_LIBDEFLATE HAVE_LIBBZ2 HAVE_LIBLZMA; do \
      if grep -q "^#define $d 1" "$hts/config.h"; then found="$found $d"; else missing="$missing $d"; fi; \
    done; \
    if [ -n "$missing" ]; then echo "HTSlib was configured without:$missing" >&2; exit 1; fi; \
    make install DESTDIR=/out; \
    rm -rf /out/usr/local/share/man; \
    find /out/usr/local/bin -type f ! -name bcftools -delete; \
    install -m 755 "$hts/bgzip" "$hts/tabix" /out/usr/local/bin/; \
    plugins=/out/usr/local/libexec/bcftools; \
    strip --strip-unneeded /out/usr/local/bin/* "$plugins"/*.so; \
    sources=$(find plugins -maxdepth 1 -name '*.c' | wc -l); \
    BCFTOOLS_PLUGINS="$plugins" /out/usr/local/bin/bcftools plugin -l > /tmp/plugins; \
    if [ "$(wc -l < /tmp/plugins)" -ne "$sources" ]; then \
      echo "$sources plugin sources, but bcftools loads $(wc -l < /tmp/plugins):" >&2; \
      BCFTOOLS_PLUGINS="$plugins" /out/usr/local/bin/bcftools plugin -l -v -v >&2 || true; exit 1; \
    fi; \
    /out/usr/local/bin/bcftools --version > /tmp/bcftools-version; \
    if [ "$(head -n 1 /tmp/bcftools-version)" != "bcftools ${VERSION}" ] \
      || ! grep -Fxq 'License Expat: The MIT/Expat license' /tmp/bcftools-version; then \
      cat /tmp/bcftools-version >&2; echo "expected bcftools ${VERSION} under the MIT/Expat license" >&2; exit 1; \
    fi; \
    meta=/out/usr/local/share/randomcontainers/bcftools; \
    mkdir -p "$meta/licenses"; \
    cp LICENSE "$meta/licenses/LICENSE"; \
    cp "$hts/LICENSE" "$meta/licenses/LICENSE.htslib"; \
    cp "$hts/htscodecs/LICENSE.md" "$meta/licenses/LICENSE.htscodecs.md"; \
    find . \( -name test -o -name tests -o -name fuzz \) -prune -o -name '*.[ch]' -print | LC_ALL=C sort > /tmp/sources; \
    while read -r f; do \
      awk -v f="${f#./}" ' \
        function check() { \
          s = 0; \
          if (b ~ /[Cc]opyright/) { \
            n = split(b, l, "\n"); \
            h = 0; \
            for (i = 1; i <= n; i++) { \
              h = (l[i] ~ /[Cc]opyright (\([Cc]\) )?[0-9A-Z]/) || (h && l[i] ~ /^[^0-9A-Za-z]*[0-9][0-9][0-9][0-9]/); \
              if (h && l[i] !~ /Genome Research/) { printf "==> %s <==\n%s\n", f, b; exit } \
            } \
            exit; \
          } \
          b = ""; \
        } \
        s && !/^ *\/\// { check() } \
        !c && !s && /^ *\/\// { s = 1; b = "" } \
        s { b = b $0 "\n"; next } \
        /\/\*/ { c = 1; b = "" } \
        c { b = b $0 "\n" } \
        c && /\*\// { c = 0; check() } \
        END { if (s) check() }' "$f"; \
    done < /tmp/sources > "$meta/licenses/NOTICES"; \
    for holder in 'Broad Institute' 'Attractive Chaos' 'GENOMICS plc' 'Eugene Shelwien'; do \
      grep -Fq "$holder" "$meta/licenses/NOTICES" || { echo "NOTICES lacks $holder" >&2; exit 1; }; \
    done; \
    echo "${VERSION}" > "$meta/version"; \
    cp /tmp/source-url "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "source-sha256: ${SOURCE_SHA256}"; \
      echo "compiler: $(cc --version | head -n 1)"; \
      sed -n 's/^  \$ \(\.\/configure .*\)/\1/p' config.log; \
      sed -n '2p' /tmp/bcftools-version; \
      echo "htslib config.h:$found"; \
      echo "plugins: $(wc -l < /tmp/plugins)"; \
    } > "$meta/buildinfo"; \
    scanelf --needed --nobanner --format '%n#p' --recursive /out/usr/local | tr ',' '\n' | LC_ALL=C sort -u > /tmp/needed; \
    for lib in libcurl libdeflate libcrypto; do \
      grep -q "^$lib\.so\." /tmp/needed || { echo "bcftools does not load $lib" >&2; exit 1; }; \
    done; \
    while read -r so; do \
      if [ -n "$so" ] && [ -z "$(find /out -name "$so" -print -quit)" ]; then echo "so:$so"; fi; \
    done < /tmp/needed > /tmp/elf-deps; \
    LC_ALL=C sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
RUN --mount=type=bind,from=build,source=/out/usr/local/share/randomcontainers/bcftools/runtime-deps,target=/tmp/runtime-deps \
    set -eu; \
    xargs apk add --no-cache ca-certificates tini < /tmp/runtime-deps; \
    addgroup -g 1000 app; \
    adduser -D -u 1000 -G app app; \
    install -d -m 1777 /work /cache
COPY --link --from=build /out/usr/local/ /usr/local/
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "bcftools"]
CMD ["--help"]
